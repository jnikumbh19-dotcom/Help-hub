{
  "name": "help-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Location-based emergency assistance platform (Frontend + Backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "npm run dev:frontend",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "seed:backend": "npm run seed --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  }
}
